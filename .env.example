# ── Vite (frontend) ────────────────────────────────────────────────────────────
# The base URL where the Vercel Functions are accessible.
# Local development: http://localhost:5173
VITE_API_URL=http://localhost:5173

# ── Clerk Authentication ────────────────────────────────────────────────────────
# Get your publishable key from the Clerk Dashboard
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here

# ── Google Gemini API (Phase 3: Hybrid AI Engine) ─────────────────────────────
# Your Google Gemini API key (free tier, no credit card required - 1,500 calls/day).
# Get one at: https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# ── LangSearch API (Primary Web Search) ─────────────────────────────────────
# Free tier: 2,000 queries/month, no credit card required
# Sign up: https://langsearch.com
VITE_LANGSEARCH_API_KEY=your_langsearch_api_key_here

# ── SearXNG Public Instances (Fallback) ─────────────────────────────────────
# Comma-separated list of verified public SearXNG instances (no auth required)
VITE_SEARXNG_INSTANCES=https://metacat.online,https://nyc1.sx.ggtyler.dev,https://ooglester.com,https://search.080609.xyz,https://search.canine.tools,https://search.catboy.house,https://search.citw.lgbt,https://search.einfachzocken.eu,https://search.federicociro.com,https://search.hbubli.cc,https://search.im-in.space,https://search.indst.eu,https://priv.au,https://opnxng.com

# ── DuckDuckGo Instant Answer (Final Fallback) ───────────────────────────────
# No API key required — used when all other search providers fail

# ── OpenRouter AI (Free Fallback) ──────────────────────────────────────────────
# Free tier: 200 requests/day, 20 requests/minute, no credit card.
# Sign up: https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=your-openrouter-key-here

# ── HuggingFace Inference API (Medical Fallback) ────────────────────────────────
# Free tier: 5,000 calls/month for models under 10GB, no credit card.
# Get token at: https://huggingface.co/settings/tokens
VITE_HF_API_KEY=your-huggingface-token-here

# ── Brave Search API (Fallback) ───────────────────────────────────────────────────
# Get your API key from https://brave.com/search/api/
VITE_BRAVE_API_KEY=your-brave-api-key-here

# ── OpenFDA API (Drug Safety) ────────────────────────────────────────────────────
# No API key required for public FDA data endpoints
VITE_OPENFDA_API_KEY=

# ── Daily Quota ───────────────────────────────────────────────────────────────
# The free tier allows 1,500 calls/day per model (Gemma 4 31B)
VITE_DAILY_QUOTA=1500

# ── Upstash Redis (Vercel KV) ────────────────────────────────────────────────────
# Used for distributed rate limiting and caching on Vercel
# Get these from https://console.upstash.com
KV_REST_API_URL=https://<your-rest-endpoint.upstash.io>
KV_REST_API_TOKEN=<your-rest-token>

# ── Squad Payment Gateway ───────────────────────────────────────────────────────
# Get your keys from https://squad.co
SQUAD_PUBLIC_KEY=pk_test_your_squad_public_key
SQUAD_SECRET_KEY=sk_test_your_squad_secret_key

# ── E2E Test Mode ────────────────────────────────────────────────────────────────
# Set to 'true' to enable test mode bypasses during Playwright tests
VITE_E2E_MODE=false
