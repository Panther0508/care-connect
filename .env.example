# ── Vite (frontend) ────────────────────────────────────────────────────────────
# The base URL where the Vercel Functions are accessible.
# Local development: http://localhost:3000
# Production: https://your-project.vercel.app
VITE_API_URL=http://localhost:3000

# ── Clerk Authentication ────────────────────────────────────────────────────────
# Get your publishable key from the Clerk Dashboard
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here

# ── Vercel Functions (backend) ─────────────────────────────────────────────────
# Your Google Gemini API key (free tier, no credit card required).
# Get one at: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-key-here

# ── Vercel KV (serverless Redis) ─────────────────────────────────────────────
# Obtain these from Vercel Dashboard → Storage → KV
KV_REST_API_URL=https://your-kv-url.upstash.io
KV_REST_API_TOKEN=your-kv-token-here
