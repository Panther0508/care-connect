    "Check for general danger signs",
    "Assess main symptoms",
    "Check for nutritional status and anemia",
    "Check immunization status and other problems",
    "Classify illnesses",
    "Identify treatment",
    "Counsel the mother",
    "Follow up"
  ],
  "general_danger_signs": {
    "unable_to_drink": {
      "sign": "Unable to drink or breastfeed",
      "action": "URGENT REFERRAL to hospital"
    },
    "vomits_everything": {
      "sign": "Vomits everything",
      "action": "URGENT REFERRAL to hospital"
    },
    "convulsions": {
      "sign": "Convulsions (now or in past)",
      "action": "URGENT REFERRAL to hospital"
    },
    "lethargic_unconscious": {
      "sign": "Lethargic or unconscious",
      "action": "URGENT REFERRAL to hospital"
    }
  },
  "main_symptoms": {
