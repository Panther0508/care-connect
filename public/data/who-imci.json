      "assessment": {
        "fast_breathing_tachypnea": {
          "2_months_to_12_months": ">=50 breaths/minute",
          "12_months_to_5_years": ">=40 breaths/minute"
        },
        "chest_indrawing": "Lower chest wall indrawing",
        "stridor_in_calm_child": "Stridor when calm"
      },
      "classifications": {
        "severe_pneumonia_or_very_severe_disease": {
          "signs": ["Chest indrawing", "Stridor in calm child", "Any general danger sign"],
          "treatment": [
            "Give first dose of appropriate antibiotic (Inj. Benzylpenicillin or Ampicillin)",
            "Give first dose of appropriate antibiotic (Ceftriaxone if available)",
            "Treat fever if present (Paracetamol)",
            "Keep warm",
            "URGENT REFERRAL to hospital"
          ]
        },
        "pneumonia": {
          "signs": ["Fast breathing", "No chest indrawing", "No general danger signs"],
          "treatment": [
            "Oral Amoxicillin",
            "Dosing: 45mg/kg/day divided BID x 5 days",
            "Soothe throat, relieve cough with safe remedy",
            "Treat fever if present",
            "Advise mother when to return immediately"
          ],
          "follow_up": "2 days"
        },
        "no_pneumonia_cough_or_cold": {
          "signs": ["No fast breathing", "No chest indrawing", "No general danger signs"],
          "treatment": [
            "No antibiotic needed",
            "Home care advice",
            "Soothe throat, relieve cough with safe remedy",
            "Feed and give fluids",
            "Follow up in 5 days if not improving"
          ]
        }
      }
    },
    "diarrhea": {
      "assessment": {
        "duration": "Diarrhea for how long?",
        "blood_in_stool": "Blood in stool?",
        "signs_of_dehydration": {
          "general_appearance": ["Well and alert", "Restless/irritable", "Lethargic/unconscious"],
          "thirst": ["Drinks eagerly", "Drinks poorly", "Unable to drink"],
          "skin_turgor": ["Pinch goes back quickly (<2 seconds)", "Pinch goes back slowly (≥2 seconds)", "Pinch goes back very slowly"]
        }
      },
      "classifications": {
        "severe_dehydration": {
          "signs": ["Lethargic/unconscious", "Unable to drink", "Skin pinch goes back very slowly"],
          "treatment": [
            "IV fluids - Ringer's Lactate (or Normal Saline)",
            "30ml/kg over 30 minutes, then 70ml/kg over 2.5 hours",
            "When child can drink, give ORS",
            "URGENT REFERRAL to hospital"
          ]
        },
        "some_dehydration": {
          "signs": ["Restless/irritable", "Drinks poorly", "Skin pinch goes back slowly"],
          "treatment": [
            "ORS",
            "75ml/kg over 4 hours",
            "Also give: Zinc 20mg daily x 10-14 days (10mg if <6 months)",
            "Continue feeding",
            "Follow up in 2 days"
          ]
        },
        "no_dehydration": {
          "signs": ["Well and alert", "Drinks eagerly", "Skin pinch goes back quickly"],
          "treatment": [
            "Home treatment to prevent dehydration",
            "Give extra fluids",
            "Zinc 20mg daily x 10-14 days (10mg if <6 months)",
            "Continue feeding",
            "Return if danger signs or no improvement in 3 days"
          ]
        },
        "dysentery": {
          "signs": ["Blood in stool"],
          "treatment": [
            "Ciprofloxacin 500mg BD x 3 days (if child >12 years)",
            "Or Azithromycin 500mg OD x 3 days (if child <12 years)",
            "Reassess in 2 days",
            "Refer if no improvement"
          ]
        }
      }
    },
    "fever": {
      "assessment": {
        "duration": "Fever for how long?",
        "measured_temperature": "Temperature?"
      },
      "classifications": {
        "severe_febrile_disease_or_malaria": {
          "general_danger_signs": "Present",
          "in_malaria_area": "In endemic area",
          "treatment": [
            "Give first dose of appropriate antimalarial if malaria suspected",
            "Give Chloramphenicol or Ampicillin/Amoxicillin",
            "URGENT REFERRAL to hospital"
          ]
        },
        "measles": {
          "signs": ["Fever with rash or history of fever with cough/coryza/conjunctivitis"],
          "treatment": [
            "Vitamin A immediately (200,000 IU)",
            "Treat fever",
            "Refer to hospital if severe complications"
          ]
        },
        "localized_bacterial_infection": {
          "signs": ["Pus draining from eye, mouth ulcers (with fever), ear discharge (with fever)"],
          "treatment": [
            "Antibiotic appropriate for infection",
            "Teach mother how to clean away discharge"
          ]
        },
        "likely_malaria_in_high_transmission_area": {
          "signs": ["In malarial area", "Fever or history of fever without other cause"],
          "treatment": [
            "Give appropriate antimalarial",
            "Find and treat other cause if present"
          ]
        },
        "likely_bacteremia_or_urinary_tract_infection": {
          "signs": ["Fever 5 days or more without other cause"],
          "treatment": [
            "Give intramuscular Benzathine Penicillin (or Procaine Penicillin)",
            "Refer urgently if not improving in 2 days"
          ]
        },
        "viral": {
          "signs": ["Fever <5 days without other cause"],
          "treatment": [
            "Paracetamol if high fever",
            "Dress child lightly",
            "Give fluids",
            "Follow up in 2 days"
          ]
        }
      }
    },
    "ear_problems": {
      "assessment": {
        "ear_pain": "Does child have ear pain?",
        "ear_discharge": "Is there ear discharge?",
        "duration": "If discharge, how long?"
      },
      "classifications": {
        "mastoiditis": {
          "signs": ["Tender swelling behind ear"],
          "treatment": ["URGENT REFERRAL to hospital"]
        },
        "chronic_ear_infection": {
          "signs": ["Ear discharge for 14 days or longer"],
          "treatment": [
            "Dry ear by wicking",
            "Ciprofloxacin ear drops",
            "Amoxicillin if fails"
          ]
        },
        "acute_ear_infection": {
          "signs": ["Ear discharge for less than 14 days or ear pain"],
          "treatment": [
            "Paracetamol for pain",
            "If discharge: Give first dose of antibiotic (Amoxicillin or Cotrimoxazole)",
            "Dry ear by wicking"
          ]
        },
        "no_ear_infection": {
          "treatment": ["No antibiotic needed"]
        }
      }
    },
    "malnutrition_and_anemia": {
      "assessment": {
        "weight_for_age": "Weight-for-age",
        "visible_severe_wasting": "Visible severe wasting?",
        "bipedal_edema": "Bipedal edema?",
        "palmar_pallor": "Palmar pallor?"
      },
      "classifications": {
        "severe_malnutrition_or_severe_anemia": {
          "signs": ["Visible severe wasting", "Bipedal edema", "Severe palmar pallor", "Weight-for-age <60%"],
          "treatment": [
            "URGENT REFERRAL to hospital",
            "If child is breastfeeding, continue",
            "Treat hypoglycemia if present (give 50ml 10% glucose or breastfeed)"
          ]
        },
        "moderate_malnutrition_or_anemia": {
          "signs": ["Weight-for-age 60-80%", "Some palmar pallor"],
          "treatment": [
            "Vitamin A",
            "Anthelmintic after diarrhea stops, or at follow up",
            "Advise mother about feeding",
            "Follow up in 30 days"
          ]
        },
        "no_malnutrition_no_anemia": {
          "treatment": [
            "Vitamin A (if indicated by national policy)",
            "Advise mother about feeding"
          ]
        }
      }
    },
    "immunization_status": {
      "assessment": "Check immunization card",
      "actions": [
        "Give vaccines indicated for age",
        "Give Vitamin A if 6 months or older"  
      ]
    }
